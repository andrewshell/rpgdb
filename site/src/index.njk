<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>My RPG Shelf</title>
<style>
:root { --bg:#f7f5f0; --card:#fff; --ink:#1d1b18; --muted:#6b665d; --line:#e2ddd2; --hit:#2f6f3e; --hit-bg:#e3f1e6; }
@media (prefers-color-scheme: dark) { :root { --bg:#151412; --card:#201e1b; --ink:#ece8e0; --muted:#9c968b; --line:#34312c; --hit:#8fd19e; --hit-bg:#1f3325; } }
* { box-sizing:border-box; }
body { margin:0; background:var(--bg); color:var(--ink); font:16px/1.4 -apple-system, system-ui, sans-serif; }
header { position:sticky; top:0; background:var(--bg); padding:12px 16px; border-bottom:1px solid var(--line); }
input { width:100%; font-size:18px; padding:12px 14px; border-radius:10px; border:1px solid var(--line); background:var(--card); color:var(--ink); }
#status { margin-top:8px; font-size:15px; color:var(--muted); }
#status.hit { color:var(--hit); font-weight:600; }
ul { list-style:none; margin:0; padding:8px 16px 40px; }
li { display:flex; gap:12px; padding:10px; margin-bottom:8px; background:var(--card); border:1px solid var(--line); border-radius:10px; }
li[hidden] { display:none; }
li img, li .noimg { width:64px; height:88px; object-fit:cover; border-radius:4px; flex:none; background:var(--line); }
li a { color:inherit; text-decoration:none; font-weight:600; }
.meta { color:var(--muted); font-size:14px; }
.copies { display:inline-block; margin-top:4px; font-size:12px; padding:1px 6px; border-radius:6px; background:var(--hit-bg); color:var(--hit); }
</style>
</head>
<body>
<header>
  <input id="q" type="search" placeholder="Do I own…?" autocomplete="off" autofocus>
  <div id="status">{{ books.length }} books</div>
</header>
<ul id="list">
{%- for b in books %}
  <li data-search="{{ [b.title, b.publisher, b.authors | join(' '), b.notes] | join(' ') }}">
    {%- if b.thumb %}<img src="{{ b.thumb }}" loading="lazy" alt="">{% else %}<div class="noimg"></div>{% endif %}
    <div>
      {% if b.url %}<a href="{{ b.url }}">{{ b.title }}</a>{% else %}<strong>{{ b.title }}</strong>{% endif %}
      <div class="meta">{{ [b.publisher, b.authors | join(', ')] | select | join(' · ') }}</div>
      {% if b.notes %}<div class="meta">{{ b.notes }}</div>{% endif %}
      {% if b.copies > 1 %}<span class="copies">{{ b.copies }} copies</span>{% endif %}
    </div>
  </li>
{%- endfor %}
</ul>
<script src="search.js"></script>
</body>
</html>
